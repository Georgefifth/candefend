{
  "metadata": {
    "benchmark": "CANDefend Real-World Automotive Cyber-Physical Benchmark v1.0",
    "sources": [
      {
        "name": "HCRL Car-Hacking Dataset (Korea University / IEEE ITS)",
        "url": "https://ocslab.hksecurity.net/Datasets/car-hacking-dataset",
        "description": "Real CAN bus traffic recorded from Hyundai YF Sonata via OBD-II port, containing verified normal, DoS, fuzzy, and drive-spoofing injection traces.",
        "license": "Open Academic & Research Use"
      },
      {
        "name": "OpenGarages ICSim Candump Traces (Craig Smith / The Car Hacker's Handbook)",
        "url": "https://github.com/zombieCraig/ICSim",
        "description": "Standardized Linux socketcan candump traces of instrument cluster arbitration IDs (0x188, 0x244, 0x19B, 0x208).",
        "license": "GPL-3.0 / Open Source"
      },
      {
        "name": "SAE J1939 / ISO 11898-1 CAN 2.0B Physical Standards",
        "url": "https://www.sae.org/standards/content/j1939_201808/",
        "description": "Kinematic acceleration thresholds, message periodicity tolerances, and arbitration priority specifications.",
        "license": "Public Automotive Standard"
      }
    ],
    "totalSamples": 40,
    "categories": [
      "Negative Baseline (Normal Highway/City Driving)",
      "DoS Flooding & Dominant Arbitration Inundation",
      "Kinematic Sensor Spoofing (Speed / RPM Injection)",
      "Replay Attacks & Freshness Sequence Tampering",
      "Rogue Arbitration & Fuzzing Probes",
      "Edge Cases & Adversarial Boundary Tests"
    ]
  },
